# Recommended persistent credentials: rollbar auth set project / rollbar auth set account
# Move existing file credentials: rollbar auth migrate --dry-run, then rollbar auth migrate
# .env values override the OS keychain until removed.
# Disable keychain lookup on headless/CI machines: ROLLBAR_KEYCHAIN=0
# ROLLBAR_KEYCHAIN=0
# Optional plaintext project overrides:
# ROLLBAR_PROJECT_TOKEN=your-project-token-here
# ROLLBAR_ACCOUNT_TOKEN=your-account-token-here
ROLLBAR_BASE_URL=https://api.rollbar.com/api/1
ROLLBAR_PROJECT_ID=
